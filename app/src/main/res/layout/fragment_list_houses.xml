<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/espresso_deep"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/catalog_gutter"
        android:layout_marginEnd="@dimen/catalog_gutter"
        android:layout_marginTop="12dp"
        android:accessibilityHeading="true"
        android:text="@string/explore_properties"
        android:textAppearance="@style/TextAppearance.App.Hero"
        tools:targetApi="p" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/catalog_gutter"
        android:layout_marginEnd="@dimen/catalog_gutter"
        android:layout_marginTop="12dp"
        android:hint="@string/property_search_hint"
        app:boxBackgroundColor="@color/surface_card"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/radius_xl"
        app:boxCornerRadiusBottomStart="@dimen/radius_xl"
        app:boxCornerRadiusTopEnd="@dimen/radius_xl"
        app:boxCornerRadiusTopStart="@dimen/radius_xl"
        app:boxStrokeColor="@color/catalog_search_stroke"
        app:endIconMode="clear_text"
        app:endIconTint="@color/champagne_gold"
        app:hintTextColor="@color/sand_muted"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/champagne_gold">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/propertySearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:saveEnabled="false"
            android:textColor="@color/cream_text"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/catalog_gutter"
        android:layout_marginEnd="@dimen/catalog_gutter"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.App.Body.Small"
        tools:text="24 properties" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHouses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/catalog_gutter"
            android:paddingEnd="@dimen/catalog_gutter"
            android:paddingBottom="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_house" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@string/loading_properties"
            android:indeterminateTint="@color/champagne_gold"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/catalog_gutter">

                <TextView
                    android:id="@+id/statusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statusAction"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:textColor="@color/champagne_gold"
                    app:strokeColor="@color/border_gold_highlight" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
