<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/catalog_filter_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/catalog_gutter">

        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:background="@color/border_gold_highlight" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/filter_properties"
            android:textAppearance="@style/TextAppearance.App.Headline.Medium"
            tools:targetApi="p" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/property_budget"
            android:textAppearance="@style/TextAppearance.App.Body.Medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/budgetChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/property_bedrooms_label"
            android:textAppearance="@style/TextAppearance.App.Body.Medium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/bedroomChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/espresso_deep"
            app:backgroundTint="@color/champagne_gold"
            app:cornerRadius="@dimen/radius_xl" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
