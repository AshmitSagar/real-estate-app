<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/espresso_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card">

            <ImageView
                android:id="@+id/housePhotoDetailed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="380dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/detailBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="14dp"
                android:background="@drawable/catalog_back_background"
                android:contentDescription="@string/back_to_properties"
                android:scaleType="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_back"
                app:tint="@color/cream_text" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/detailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/loading_property"
            android:textAppearance="@style/TextAppearance.App.Body.Medium" />

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/catalog_gutter"
            android:paddingEnd="@dimen/catalog_gutter"
            android:paddingTop="18dp"
            android:paddingBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/housePriceDetailed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.App.Hero"
                android:textColor="@color/champagne_gold"
                tools:targetApi="p"
                tools:text="$285,000" />

            <TextView
                android:id="@+id/housePlaceDetailed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.App.Body.Medium"
                tools:text="Amsterdam · 1034 ZH" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:divider="@drawable/catalog_stat_divider"
                android:orientation="horizontal"
                android:showDividers="middle">

                <LinearLayout style="@style/Widget.App.PropertyMetric">

                    <TextView
                        android:id="@+id/houseBedrooms"
                        style="@style/Widget.App.PropertyMetric.Value"
                        tools:text="5" />

                    <TextView
                        style="@style/Widget.App.PropertyMetric.Label"
                        android:text="@string/property_bedrooms_label" />

                </LinearLayout>

                <LinearLayout style="@style/Widget.App.PropertyMetric">

                    <TextView
                        android:id="@+id/houseBathrooms"
                        style="@style/Widget.App.PropertyMetric.Value"
                        tools:text="3" />

                    <TextView
                        style="@style/Widget.App.PropertyMetric.Label"
                        android:text="@string/property_bathrooms_label" />

                </LinearLayout>

                <LinearLayout style="@style/Widget.App.PropertyMetric">

                    <TextView
                        android:id="@+id/houseArea"
                        style="@style/Widget.App.PropertyMetric.Value"
                        tools:text="275 m²" />

                    <TextView
                        style="@style/Widget.App.PropertyMetric.Label"
                        android:text="@string/property_area_label" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/descriptionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/about_this_property"
                android:textAppearance="@style/TextAppearance.App.Headline.Medium"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/descriptionDetailedTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.App.Body.Medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/border_gold_subtle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:accessibilityHeading="true"
                android:text="@string/location"
                android:textAppearance="@style/TextAppearance.App.Headline.Medium"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/houseDistanceDetailed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.App.Body.Small" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Luxury"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="@dimen/radius_xl">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.gms.maps.MapView
                        android:id="@+id/mapViewHouseLocation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="noHideDescendants"
                        app:liteMode="true" />

                    <TextView
                        android:id="@+id/mapFallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_card"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/map_preview_unavailable"
                        android:textAppearance="@style/TextAppearance.App.Body.Small" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openMap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/open_in_maps"
                android:textAllCaps="false"
                android:textColor="@color/champagne_gold"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart"
                app:iconTint="@color/champagne_gold"
                app:strokeColor="@color/border_gold_highlight" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
