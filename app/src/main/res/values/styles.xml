<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Text Appearances -->

    <!-- Hero Display Text -->
    <style name="TextAppearance.App.Hero" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">serif</item>
        <item name="android:textSize">@dimen/text_hero_mobile</item>
        <item name="android:textColor">@color/cream_text</item>
    </style>

    <!-- Headline Medium -->
    <style name="TextAppearance.App.Headline.Medium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">serif</item>
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:textColor">@color/cream_text</item>
    </style>

    <!-- Price Text -->
    <style name="TextAppearance.App.Price" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">serif</item>
        <item name="android:textSize">@dimen/text_headline_small</item>
        <item name="android:textColor">@color/champagne_gold</item>
    </style>

    <!-- Body Text Large -->
    <style name="TextAppearance.App.Body.Large" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/sand_muted</item>
    </style>

    <!-- Body Text Medium -->
    <style name="TextAppearance.App.Body.Medium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:textColor">@color/sand_muted</item>
    </style>

    <!-- Body Text Small -->
    <style name="TextAppearance.App.Body.Small" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/sand_muted</item>
    </style>

    <!-- Label/Metadata Text -->
    <style name="TextAppearance.App.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_label_uppercase</item>
        <item name="android:textColor">@color/smoke_subtle</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Component Styles -->

    <style name="Widget.App.CatalogChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/catalog_chip_background</item>
        <item name="android:textColor">@color/catalog_chip_text</item>
        <item name="chipStrokeColor">@color/border_gold_highlight</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="Widget.App.BookmarkButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/catalog_back_background</item>
        <item name="android:contentDescription">@string/save_property</item>
        <item name="android:scaleType">center</item>
        <item name="srcCompat">@drawable/catalog_bookmark</item>
    </style>

    <style name="Widget.App.PropertyMetric" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.App.PropertyMetric.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Price</item>
    </style>

    <style name="Widget.App.PropertyMetric.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body.Small</item>
    </style>

    <!-- Luxury Card Style -->
    <style name="Widget.App.Card.Luxury" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/border_gold_subtle</item>
        <item name="strokeWidth">@dimen/border_subtle</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/espresso_deep</item>
        <item name="itemIconTint">@drawable/bottom_nav_icon_color_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_icon_color_selector</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="background">@color/espresso_deep</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.Headline.Medium</item>
        <item name="titleTextColor">@color/cream_text</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
