<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <action
        android:id="@+id/actionOpenProperty"
        app:destination="@id/detailedHouseFragment" />

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.xmlrealestate.ui.screens.home.ListHouseFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_list_houses" />

    <fragment
        android:id="@+id/navigation_saved"
        android:name="com.example.xmlrealestate.ui.screens.home.ListHouseFragment"
        android:label="@string/saved_tab"
        tools:layout="@layout/fragment_list_houses">
        <argument
            android:name="savedOnly"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/detailedHouseFragment"
        android:name="com.example.xmlrealestate.ui.screens.detailedHouse.DetailedHouseFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_detailed_house">
        <argument
            android:name="houseId"
            app:argType="string" />
        <argument
            android:name="animatePhoto"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/navigation_info"
        android:name="com.example.xmlrealestate.ui.screens.about.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_about" />
</navigation>
