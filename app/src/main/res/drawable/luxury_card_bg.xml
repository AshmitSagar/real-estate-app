<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>

    <!-- Subtle Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/border_subtle"
                android:color="@color/border_gold_subtle" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
</layer-list>
